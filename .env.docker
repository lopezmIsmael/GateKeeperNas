# Gatekeeper NAS - Docker Environment Variables
# Copia este archivo a .env y ajusta los valores

# ============================================
# SEGURIDAD - CAMBIAR EN PRODUCCION
# ============================================
SECRET_KEY=genera-una-clave-secreta-larga-y-aleatoria

# ============================================
# SERVIDOR DE ALMACENAMIENTO (Ubuntu Server)
# ============================================
SERVER_IP=192.168.10.14
SERVER_MAC=b4:b5:2f:39:fd:d8
SERVER_BROADCAST=192.168.10.255

# ============================================
# NFS
# ============================================
NFS_EXPORT=192.168.10.14:/datos

# ============================================
# SSH
# ============================================
SSH_USER=gatekeeper
SSH_PORT=22
# Ruta a la llave SSH en el HOST (se monta en el contenedor)
SSH_KEY_PATH=/home/pi/.ssh/id_rsa

# ============================================
# CUOTAS
# ============================================
DEFAULT_QUOTA_GB=500
QUOTA_MOUNT_POINT=/datos
